{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "generated/prisma/**/*",
        "outDir": "dist"
      },
      {
        "include": "scenario-type/scenario-rubric-seed-data.json",
        "outDir": "dist"
      },
      {
        "include": "chat/prompt-template-seed-data.json",
        "outDir": "dist"
      }
    ]
  }
}
